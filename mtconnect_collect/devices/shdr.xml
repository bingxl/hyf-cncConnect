        <DataItem id="program" type="PROGRAM" category="EVENT"/>
        <DataItem id="programInfo" type="PROGRAM_COMMENT" category="EVENT"/>
        <DataItem id="pathFeedrate" type="PATH_FEEDRATE" category="SAMPLE"/>
